{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Win32: Build and Run",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "build-and-run.bat"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Linux/macOS: Build and Run",
            "type": "shell",
            "command": "bash",
            "args": [
                "build-and-run.sh"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
